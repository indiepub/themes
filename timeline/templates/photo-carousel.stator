---
import { Picture } from '@statorjs/stator/components'

interface Photo {
  url: string
  width?: number | null | undefined
  height?: number | null | undefined
  alt?: string | null | undefined
}

const { photos, fallbackAlt = '', sizes = '(min-width: 768px) 600px, 100vw', priority = false } = Stator.props<{
  photos: Photo[]
  fallbackAlt?: string
  sizes?: string
  priority?: boolean
}>()
const multi = photos.length > 1
---
{photos.length > 0 ? (
  <div
    class={multi ? 'carousel multi' : 'carousel'}
    role={multi ? 'group' : undefined}
    aria-label={multi ? `${photos.length} photos` : undefined}
  >
    <div class="track" tabindex={multi ? '0' : undefined}>
      {photos.map((p, i) => (
        <div class="slide">
          <div class="bg" style={`background-image: url('${p.url}')`} aria-hidden="true"></div>
          {p.width && p.height ? (
            <Picture
              src={p.url}
              width={p.width}
              height={p.height}
              alt={p.alt || fallbackAlt}
              class="u-photo"
              sizes={sizes}
              widths={[400, 800, 1200]}
              loading={priority && i === 0 ? 'eager' : 'lazy'}
            />
          ) : (
            <img class="u-photo" src={p.url} alt={p.alt || fallbackAlt} loading="lazy" />
          )}
          {multi ? <span class="count" aria-hidden="true">{i + 1}/{photos.length}</span> : null}
        </div>
      ))}
    </div>
  </div>
) : null}

<style>
  .carousel {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-2);
  }

  .track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    transform: scale(1.08);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.55) saturate(1.2);
  }

  .slide :global(picture),
  .slide :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .count {
    position: absolute;
    z-index: 2;
    top: var(--space-2);
    right: var(--space-2);
    padding: 0.1em 0.5em;
    border-radius: var(--radius-full);
    background: oklch(0% 0 0 / 0.55);
    color: oklch(100% 0 0);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
</style>
