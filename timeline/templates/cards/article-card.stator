---
import { raw } from '@statorjs/stator/template'
import type { InteractionCounts } from '../../lib/types.ts'
import type { Shown } from '@indiepub/stator/server/access'
import { renderInlineMarkdown } from '@indiepub/stator/server/render'
import { pubDate } from '../../lib/format.ts'
import CardFooter from '../card-footer.stator'
import TagList from '../tag-list.stator'
import CardHeader from './card-header.stator'

const { entry, counts, href, badge } = Stator.props<{
  entry: Shown
  counts?: InteractionCounts | undefined
  href: string
  badge?: string | undefined
}>()
---
<div class="card">
  <CardHeader entry={entry} badge={badge} />
  <h2 class="p-name">
    <a href={href} class="u-url">{entry.name}</a>
  </h2>
  {entry.summary ? <p class="p-summary">{raw(renderInlineMarkdown(entry.summary))}</p> : null}
  <TagList tags={entry.tags ?? []} />
  <CardFooter
    href={href}
    date={pubDate(entry)}
    counts={counts}
    syndicationUrls={entry.syndicationUrls}
    readMore="Read article →"
  />
</div>

<style>
  .card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  h2 a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-text-link);
    text-decoration: none;
  }

  p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
