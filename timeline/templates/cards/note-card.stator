---
import { raw } from '@statorjs/stator/template'
import type { InteractionCounts } from '../../lib/types.ts'
import type { Shown } from '@indiepub/stator/server/access'
import { renderBodyMarkdown } from '@indiepub/stator/server/render'
import { icon } from '../../lib/icons.ts'
import { hostname, pubDate } from '../../lib/format.ts'
import CardFooter from '../card-footer.stator'
import PhotoCarousel from '../photo-carousel.stator'
import CardHeader from './card-header.stator'
import GatedTeaser from './gated-teaser.stator'

const { entry, counts, href, badge } = Stator.props<{
  entry: Shown
  counts?: InteractionCounts | undefined
  href: string
  badge?: string | undefined
}>()
const photos = entry.attachments ?? []
---
<div class="card">
  <CardHeader entry={entry} badge={badge} />
  {entry.inReplyTo ? (
    <p class="reply-pill">
      {icon('corner-down-right')}
      <span class="text-secondary text-sm">in reply to </span>
      <a href={entry.inReplyTo} class="u-in-reply-to" rel="noopener" target="_blank">{hostname(entry.inReplyTo)}</a>
    </p>
  ) : null}
  {entry.gated ? <GatedTeaser entry={entry} href={href} /> : null}
  {!entry.gated && entry.content ? <div class="e-content prose">{raw(renderBodyMarkdown(entry.content))}</div> : null}
  {photos.length > 0 ? (
    <div class="media">
      <PhotoCarousel photos={photos} fallbackAlt={entry.summary ?? ''} />
    </div>
  ) : null}
  <CardFooter href={href} date={pubDate(entry)} counts={counts} syndicationUrls={entry.syndicationUrls} />
</div>

<style>
  .card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .reply-pill {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .reply-pill :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }

  .media {
    border-radius: var(--radius-md);
    overflow: hidden;
  }
</style>
