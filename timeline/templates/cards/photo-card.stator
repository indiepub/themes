---
import type { InteractionCounts } from '../../lib/types.ts'
import type { Shown } from '@indiepub/stator/server/access'
import { entrySummary } from '@indiepub/stator/server/render'
import { pubDate } from '../../lib/format.ts'
import CardFooter from '../card-footer.stator'
import PhotoCarousel from '../photo-carousel.stator'
import CardHeader from './card-header.stator'
import GatedTeaser from './gated-teaser.stator'

const { entry, counts, href, badge } = Stator.props<{
  entry: Shown
  counts?: InteractionCounts | undefined
  href: string
  badge?: string | undefined
}>()
const photos = entry.attachments?.length ? entry.attachments : entry.photo ? [{ url: entry.photo }] : []
const caption = entry.gated ? '' : entrySummary(entry)
---
<div class="card">
  <PhotoCarousel photos={photos} fallbackAlt={entry.summary ?? entry.name ?? ''} />
  <div class="body">
    <CardHeader entry={entry} />
    {entry.gated ? <GatedTeaser entry={entry} href={href} /> : null}
    {caption ? <p class="p-summary">{caption}</p> : null}
    <CardFooter href={href} date={pubDate(entry)} counts={counts} syndicationUrls={entry.syndicationUrls} badge={badge} />
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
