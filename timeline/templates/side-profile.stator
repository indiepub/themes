---
import { raw } from '@statorjs/stator/template'
import type { Author } from '../lib/types.ts'
import type { Shown } from '@indiepub/stator/server/access'
import { markdownText, renderInlineMarkdown } from '@indiepub/stator/server/render'
import SubscribeForm from '@indiepub/stator/components/subscribe-form.stator'
import { icon } from '../lib/icons.ts'
import { formatDate, hostname, pubDate, socialIcon } from '../lib/format.ts'

const { author, links, tags, now, path = '', mobile = false } = Stator.props<{
  author: Author
  links: Array<{ label: string; url: string; icon: string }>
  tags: Array<{ name: string; slug: string; count: number }>
  now: Shown | null
  path?: string | undefined
  /** Rendered inside the mobile overlay: element ids get their own prefix. */
  mobile?: boolean
}>()

const NAV = [
  { href: '/', label: 'All posts' },
  { href: '/now', label: 'Now' },
  { href: '/notes', label: 'Notes' },
  { href: '/articles', label: 'Articles' },
  { href: '/photos', label: 'Photos' },
  { href: '/bookmarks', label: 'Bookmarks' },
]
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`)
const domain = author.url ? hostname(author.url) : undefined
const nowSnippet = now && !now.gated && now.content ? markdownText(now.content) : now?.summary ?? ''
---
<div class={mobile ? 'side-profile h-card mobile' : 'side-profile h-card'}>
  {author.photo ? (
    <a href="/about" class="avatar">
      <img class="u-photo" src={author.photo} alt={author.name} width="72" height="72" />
    </a>
  ) : null}

  <div class="identity">
    <a href={author.url ?? '/about'} class="p-name u-url name" rel="me">{author.name}</a>
    {domain ? <span class="text-sm text-secondary">{domain}</span> : null}
    {author.bio ? <p class="p-note bio text-sm">{raw(renderInlineMarkdown(author.bio))}</p> : null}
  </div>

  <hr />

  <nav aria-label="Site navigation">
    {NAV.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>

  <hr />

  <div class="group subscribe">
    <p class="label text-xs text-secondary">Subscribe</p>
    <ul class="feed-links">
      <li><a href="/feed.xml" title="RSS feed">{icon('rss')}<span>RSS</span></a></li>
      <li><a href="/feed.atom" title="Atom feed">{icon('rss')}<span>Atom</span></a></li>
      <li><a href="/feed.json" title="JSON Feed">{icon('rss')}<span>JSON</span></a></li>
    </ul>
    <SubscribeForm id={mobile ? 'menu-subscribe' : 'side-subscribe'} />
  </div>

  {now ? (
    <section class="now">
      <header>
        <strong>Now</strong>
        <time datetime={pubDate(now).toISOString()}>{formatDate(pubDate(now))}</time>
      </header>
      {nowSnippet ? <p>{nowSnippet}</p> : null}
      <a href="/now">View /now &rarr;</a>
    </section>
  ) : null}

  {tags.length > 0 ? (
    <div class="group">
      <p class="label text-xs text-secondary">Topics</p>
      <div class="cloud">
        {tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.slug)}`}
            aria-current={path === `/tags/${tag.slug}` ? 'page' : undefined}
          >
            #{tag.name}
          </a>
        ))}
      </div>
    </div>
  ) : null}

  {links.length > 0 ? (
    <div class="social" aria-label="Social profiles">
      {links.map((link) => (
        <a href={link.url} class="u-url" rel="me noopener" target="_blank" aria-label={link.label} title={link.label}>
          {icon(socialIcon(link.icon))}
        </a>
      ))}
    </div>
  ) : null}

  <div class="theme-toggle" role="group" aria-label="Color theme" hidden>
    <button type="button" data-theme-value="light" title="Light mode" aria-pressed="false">
      {icon('sun')}
      <span class="sr-only">Light</span>
    </button>
    <button type="button" data-theme-value="dark" title="Dark mode" aria-pressed="false">
      {icon('moon')}
      <span class="sr-only">Dark</span>
    </button>
    <button type="button" data-theme-value="auto" title="Auto (system)" aria-pressed="false">
      {icon('monitor')}
      <span class="sr-only">Auto</span>
    </button>
  </div>
</div>

<style>
  .side-profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .avatar {
    display: block;
    width: 4.5rem;
    text-decoration: none;
  }

  .avatar img {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    text-decoration: none;
    line-height: var(--leading-snug);
  }

  .name:hover {
    color: var(--color-text-link);
    text-decoration: none;
  }

  .bio {
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition), background-color var(--transition);
  }

  nav a:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-2);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--color-text-link);
    background-color: var(--color-brand-muted);
  }

  nav a[aria-current='page']:hover {
    color: var(--color-text-link-hover);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--weight-semibold);
  }

  .feed-links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
  }

  .feed-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.2rem var(--space-2);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    transition: color var(--transition), background-color var(--transition);
  }

  .feed-links a:hover {
    color: var(--color-text-link);
    background-color: var(--color-brand-muted);
    text-decoration: none;
  }

  .feed-links :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  .subscribe :global(input[type='email']) {
    flex-basis: 100%;
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
  }

  .subscribe :global(button) {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-5);
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background-color: var(--color-surface-2);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-text-link);
  }

  .now header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .now strong {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-link);
  }

  .now time {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .now p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .now a {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-link);
    text-decoration: none;
  }

  .now a:hover {
    text-decoration: underline;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .cloud a {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.2em 0.5em;
    border-radius: var(--radius-full);
    transition: color var(--transition), background-color var(--transition);
  }

  .cloud a:hover,
  .cloud a[aria-current='page'] {
    color: var(--color-text-link);
    background-color: var(--color-brand-muted);
    text-decoration: none;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition), background-color var(--transition);
  }

  .social a:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-2);
    text-decoration: none;
  }

  .social :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-1);
    margin-top: auto;
    background-color: var(--color-surface-2);
    border-radius: var(--radius-full);
    padding: var(--space-1);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }

  .theme-toggle button:hover {
    background-color: var(--color-surface-3);
    color: var(--color-text-primary);
  }

  .theme-toggle button[aria-pressed='true'] {
    background-color: var(--color-surface-1);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
  }

  .theme-toggle :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
