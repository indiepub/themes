---
import { raw } from '@statorjs/stator/template'
import type { Interaction } from '../lib/types.ts'
import type { InteractionGroups } from '@indiepub/stator/server/entries'
import { count, renderReply } from '@indiepub/stator/server/render'
import { icon } from '../lib/icons.ts'
import { formatDateCompact, hostname } from '../lib/format.ts'

const { groups } = Stator.props<{ groups: InteractionGroups }>()
const replies = [...groups.comments, ...groups.mentions].sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime())
const total = groups.likes.length + groups.reposts.length + replies.length

const SOURCES: Record<string, string> = { bluesky: 'Bluesky', mastodon: 'Mastodon' }
const sourceLabel = (i: Interaction): string =>
  SOURCES[i.source] ?? (i.externalUrl ? hostname(i.externalUrl) : i.authorUrl ? hostname(i.authorUrl) : 'the web')
const link = (i: Interaction): string => i.authorUrl ?? i.externalUrl ?? '#'

const piles = [
  { icon: 'heart', label: count(groups.likes.length, 'like'), items: groups.likes },
  { icon: 'repeat-2', label: count(groups.reposts.length, 'repost'), items: groups.reposts },
].filter((p) => p.items.length > 0)
---
{total > 0 ? (
  <section aria-labelledby="responses-heading">
    <h2 id="responses-heading">
      Responses <span>({total})</span>
    </h2>

    {piles.map((pile) => (
      <div class="pile" aria-label={pile.label}>
        <p class="text-sm text-secondary">
          {icon(pile.icon)}
          {pile.label}
        </p>
        <div class="avatars">
          {pile.items.slice(0, 12).map((r) =>
            r.authorPhoto ? (
              <a href={link(r)} class="h-card u-url" rel="nofollow noopener" target="_blank" title={r.authorName ?? undefined}>
                <img class="u-photo" src={r.authorPhoto} alt={r.authorName ?? ''} width="32" height="32" loading="lazy" />
              </a>
            ) : (
              <a
                href={link(r)}
                class="h-card u-url placeholder"
                rel="nofollow noopener"
                target="_blank"
                title={r.authorName ?? undefined}
                aria-label={r.authorName ?? sourceLabel(r)}
              >
                {icon('user')}
              </a>
            ),
          )}
          {pile.items.length > 12 ? <span class="overflow">+{pile.items.length - 12}</span> : null}
        </div>
      </div>
    ))}

    {replies.length > 0 ? (
      <div class="replies" aria-label="Replies">
        <p class="text-sm text-secondary">
          {icon('message-square')}
          {count(replies.length, 'reply', 'replies')}
        </p>
        <ul>
          {replies.map((r) => (
            <li class="p-comment h-cite">
              {r.authorPhoto ? <img src={r.authorPhoto} alt="" width="36" height="36" loading="lazy" /> : null}
              <div>
                <a href={link(r)} class="author p-author h-card" rel="nofollow noopener" target="_blank">
                  {r.authorName ?? sourceLabel(r)}
                </a>
                {r.content ? <div class="p-content text-sm">{raw(renderReply(r.content))}</div> : null}
                <a href={r.externalUrl ?? link(r)} class="source text-xs text-secondary u-url" rel="nofollow noopener" target="_blank">
                  {sourceLabel(r)} ·{' '}
                  <time class="dt-published" datetime={r.createdAt.toISOString()}>{formatDateCompact(r.createdAt)}</time>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
  </section>
) : null}

<style>
  section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  h2 {
    font-size: var(--text-lg);
  }

  h2 span {
    font-weight: var(--weight-normal);
    color: var(--color-text-secondary);
  }

  .pile,
  .replies {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pile > p,
  .replies > p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pile > p :global(svg),
  .replies > p :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .avatars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .avatars a {
    display: block;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 2px solid var(--color-bg);
    margin-left: -0.375rem;
    transition: transform var(--transition);
    text-decoration: none;
  }

  .avatars a:first-child {
    margin-left: 0;
  }

  .avatars a:hover {
    transform: translateY(-2px);
    z-index: 1;
    position: relative;
  }

  .avatars img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-2);
    color: var(--color-text-tertiary);
  }

  .avatars .placeholder {
    display: inline-flex;
  }

  .placeholder :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .overflow {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-left: var(--space-2);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  li > img {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }

  li > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .author {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .author:hover {
    color: var(--color-text-link);
  }

  .p-content {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .source {
    text-decoration: none;
  }

  .source:hover {
    color: var(--color-text-link);
  }
</style>
