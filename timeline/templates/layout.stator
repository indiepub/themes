---
import IndiewebHead from '@indiepub/stator/components/indieweb-head.stator'
import { getAuthor, listEntries, siteSetting, socialLinks, topTags } from '@indiepub/stator/server/entries'
import { SITE_NAME, SITE_ORIGIN } from '@indiepub/stator/server/site'
import SideProfile from './side-profile.stator'

const { title, description, path, ogImage } = Stator.props<{
  title?: string | undefined
  description?: string | undefined
  /** The page's own path: the canonical link and the current nav item. */
  path?: string | undefined
  ogImage?: string | undefined
}>()


const author = getAuthor()
const links = socialLinks()
const tags = topTags(20)
const now = listEntries({ types: ['note'], tag: 'now', limit: 1 })[0] ?? null
const favicon = siteSetting('favicon_url')
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME
const canonical = path ? `${SITE_ORIGIN}${path}` : undefined
const og = ogImage ?? siteSetting('og_image_url') ?? undefined
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description ? <meta name="description" content={description} /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {favicon ? <link rel="icon" href={favicon} /> : null}
    <meta property="og:title" content={pageTitle} />
    {description ? <meta property="og:description" content={description} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta property="og:type" content="website" />
    {og ? <meta property="og:image" content={og.startsWith('http') ? og : `${SITE_ORIGIN}${og}`} /> : null}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <script src="/static/theme-boot.js"></script>
    <link rel="stylesheet" href="/static/global.css" />
    <link rel="stylesheet" href="/highlight.css" />
    <IndiewebHead />
    <script src="/static/timeline.js" defer></script>
  </head>
  <body>
    <header class="mobile-header">
      <a href="/">{SITE_NAME}</a>
      <button type="button" id="hamburger-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <SideProfile author={author} links={links} tags={tags} now={now} path={path} mobile />
    </div>

    <div class="app-layout">
      <aside class="app-sidebar">
        <SideProfile author={author} links={links} tags={tags} now={now} path={path} />
      </aside>
      <main class="app-main" id="main-content">
        <children />
      </main>
    </div>
  </body>
</html>

<style>
  .mobile-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 100;
    height: 3rem;
    padding: 0 var(--space-4);
    background-color: var(--color-surface-1);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    justify-content: space-between;
  }

  .mobile-header a {
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .mobile-header a:hover {
    color: var(--color-text-link);
    text-decoration: none;
  }

  .mobile-header button {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    padding: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: background-color var(--transition);
  }

  .mobile-header button:hover {
    background-color: var(--color-surface-2);
  }

  .mobile-header button span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 1px;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 3rem;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    background-color: var(--color-surface-1);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4);
    overflow-y: auto;
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition: transform 200ms ease, opacity 200ms ease, visibility 200ms;
  }

  .mobile-menu.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .app-layout {
    display: flex;
    justify-content: center;
    max-width: var(--app-max-width);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    gap: var(--space-8);
  }

  .app-sidebar {
    flex-shrink: 0;
    width: var(--sidebar-width);
  }

  .app-main {
    flex: 1;
    min-width: 0;
    max-width: var(--feed-max-width);
  }

  @media (max-width: 767px) {
    .mobile-header {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }

    .app-sidebar {
      display: none;
    }

    .app-layout {
      padding-top: var(--space-4);
    }
  }
</style>
