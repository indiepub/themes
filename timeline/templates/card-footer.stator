---
import type { InteractionCounts } from '../lib/types.ts'
import { icon } from '../lib/icons.ts'
import { formatDateCompact, syndicationMeta } from '../lib/format.ts'

const { href, date, counts, syndicationUrls = [], badge, readMore } = Stator.props<{
  href: string
  date: Date
  counts?: InteractionCounts | undefined
  syndicationUrls?: string[] | undefined
  /** A type badge after the date. */
  badge?: string | undefined
  /** A trailing link to the post, e.g. "Read article →". */
  readMore?: string | undefined
}>()
const hasCounts = !!counts && (counts.likes > 0 || counts.reposts > 0 || counts.comments > 0)
---
<footer>
  <a href={href} class="u-url">
    <time class="dt-published" datetime={date.toISOString()}>{formatDateCompact(date)}</time>
  </a>
  {badge ? <span class="type-badge">{badge}</span> : null}
  {hasCounts && counts ? (
    <span class="counts">
      {counts.likes > 0 ? <span aria-label={`${counts.likes} likes`}>{icon('heart')}{counts.likes}</span> : null}
      {counts.reposts > 0 ? <span aria-label={`${counts.reposts} reposts`}>{icon('repeat-2')}{counts.reposts}</span> : null}
      {counts.comments > 0 ? <span aria-label={`${counts.comments} replies`}>{icon('message-square')}{counts.comments}</span> : null}
    </span>
  ) : null}
  <span class="actions">
    {syndicationUrls.map((url) => {
      const meta = syndicationMeta(url)
      return (
        <a href={url} class="u-syndication" rel="syndication noopener" target="_blank" aria-label={`${meta.label} (syndicated copy)`}>
          {icon(meta.icon)}
        </a>
      )
    })}
    {readMore ? <a href={href} class="read-link">{readMore}</a> : null}
  </span>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .u-url {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-decoration: none;
    flex-shrink: 0;
  }

  .u-url:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .counts {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .counts > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .counts :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    flex-wrap: wrap;
  }

  .u-syndication {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .u-syndication:hover {
    color: var(--color-text-link);
    text-decoration: none;
  }

  .u-syndication :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .read-link {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-link);
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }
</style>
