---
import { Picture } from '@statorjs/stator/components'
import { reader, type Shown } from '@indiepub/stator/server/access'
import { listEntries } from '@indiepub/stator/server/entries'
import { entryTitle } from '@indiepub/stator/server/render'
import { icon } from '../lib/icons.ts'
import { audienceLabel, pageOf, paginate } from '../lib/format.ts'
import Layout from '../templates/layout.stator'
import PageHeading from '../templates/page-heading.stator'
import Pagination from '../templates/pagination.stator'

const audience = reader(Stator.request, Stator.response)
const page = pageOf(Stator.request.query)
const { items, hasPrev, hasNext } = paginate(
  (limit, offset) => listEntries({ types: ['photo'], limit, offset, audience }),
  page,
)

function cover(entry: Shown) {
  const first = entry.attachments?.[0]
  if (first) return first
  return entry.photo ? { url: entry.photo, width: undefined, height: undefined, alt: undefined } : null
}
---
<Layout title="Photos" path="/photos">
  <PageHeading title="Photos" lede="A visual stream." />

  {items.length > 0 ? (
    <div class="grid h-feed" aria-label="Photos">
      {items.map((entry, i) => {
        const photo = cover(entry)
        const count = entry.attachments?.length ?? 0
        const locked = audienceLabel(entry)
        return (
          <article class="cell h-entry">
            <a class="u-url" href={`/${entry.slug}`} aria-label={photo?.alt || entryTitle(entry) || 'Photo'}>
              {photo && photo.width && photo.height ? (
                <Picture
                  src={photo.url}
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt ?? ''}
                  class="u-photo"
                  crop={1}
                  widths={[400, 800]}
                  sizes="(max-width: 767px) 50vw, 200px"
                  loading={i < 6 ? 'eager' : 'lazy'}
                />
              ) : photo ? (
                <img class="u-photo" src={photo.url} alt={photo.alt ?? ''} loading="lazy" />
              ) : (
                <span class="locked">{icon('lock')}<span>{locked ?? 'Subscribers'}</span></span>
              )}
              {count > 1 ? <span class="badge" title={`${count} photos`}>{count}</span> : null}
            </a>
          </article>
        )
      })}
    </div>
  ) : (
    <p class="empty-state text-secondary">No photos yet.</p>
  )}
  <Pagination base="/photos" page={page} hasPrev={hasPrev} hasNext={hasNext} />
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .cell {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  .cell a {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .cell :global(picture),
  .cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--transition);
  }

  .cell a:hover :global(img),
  .cell a:focus-visible :global(img) {
    opacity: 0.85;
  }

  .locked {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 100%;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .locked :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: 0.1em 0.5em;
    border-radius: var(--radius-full);
    background: oklch(0% 0 0 / 0.55);
    color: oklch(100% 0 0);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .empty-state {
    padding: var(--space-8) 0;
    text-align: center;
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
