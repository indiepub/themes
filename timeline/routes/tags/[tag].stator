---
import { reader } from '@indiepub/stator/server/access'
import { listEntries } from '@indiepub/stator/server/entries'
import { count } from '@indiepub/stator/server/render'
import { pageOf, paginate } from '../../lib/format.ts'
import FeedList from '../../templates/feed-list.stator'
import Layout from '../../templates/layout.stator'
import PageHeading from '../../templates/page-heading.stator'
import Pagination from '../../templates/pagination.stator'

const tag = String(Stator.request.params.tag)
const audience = reader(Stator.request, Stator.response)
const page = pageOf(Stator.request.query)
const { items, hasPrev, hasNext } = paginate((limit, offset) => listEntries({ tag, limit, offset, audience }), page)
const base = `/tags/${encodeURIComponent(tag)}`
---
<Layout title={`#${tag}`} path={base}>
  <PageHeading title={`#${tag}`} lede={page === 1 && !hasNext ? count(items.length, 'post') : undefined} />
  <FeedList entries={items} label={`Posts tagged ${tag}`} empty={`No posts tagged #${tag}.`} />
  <Pagination base={base} page={page} hasPrev={hasPrev} hasNext={hasNext} />
</Layout>
