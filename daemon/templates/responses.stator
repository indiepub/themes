---
import { raw } from '@statorjs/stator/template'
import type { InteractionGroups } from '@indiepub/stator/server/entries'
import { count, renderReply } from '@indiepub/stator/server/render'
import { hostname } from '../lib/format.ts'
import type { Interaction } from '../lib/types.ts'
import Icon from './icon.stator'

const { groups } = Stator.props<{ groups: InteractionGroups }>()

const sourceLabel = (i: Interaction): string =>
  i.source === 'bluesky'
    ? 'Bluesky'
    : i.source === 'mastodon'
      ? 'Mastodon'
      : hostname(i.externalUrl ?? i.authorUrl ?? '')
const link = (i: Interaction): string => i.authorUrl ?? i.externalUrl ?? '#'

const piles = [
  { icon: 'heart', label: count(groups.likes.length, 'like'), items: groups.likes },
  { icon: 'repeat-2', label: count(groups.reposts.length, 'repost'), items: groups.reposts },
  { icon: 'bookmark', label: count(groups.bookmarks.length, 'bookmark'), items: groups.bookmarks },
].filter((p) => p.items.length > 0)
const replies = [...groups.comments, ...groups.mentions].sort((a, b) => +a.createdAt - +b.createdAt)
const total = piles.reduce((n, p) => n + p.items.length, 0) + replies.length
---
{total > 0 ? (
  <section aria-labelledby="responses-heading">
    <h2 id="responses-heading">
      Responses <span>({total})</span>
    </h2>

    {piles.map((pile) => (
      <div class="pile" aria-label={pile.label}>
        <p class="label">
          <Icon name={pile.icon} />
          {pile.label}
        </p>
        <div class="avatars">
          {pile.items.slice(0, 12).map((i) =>
            i.authorPhoto ? (
              <a href={link(i)} rel="noopener nofollow" target="_blank" title={i.authorName}>
                <img src={i.authorPhoto} alt={i.authorName ?? ''} width="32" height="32" />
              </a>
            ) : (
              <a href={link(i)} rel="noopener nofollow" target="_blank" title={i.authorName} class="placeholder" aria-label={i.authorName ?? sourceLabel(i)}>
                <Icon name="user" />
              </a>
            ),
          )}
          {pile.items.length > 12 ? <span class="overflow">+{pile.items.length - 12}</span> : null}
        </div>
      </div>
    ))}

    {replies.length > 0 ? (
      <div class="replies" aria-label="Replies">
        <p class="label">
          <Icon name="message-square" />
          {count(replies.length, 'reply', 'replies')}
        </p>
        <ul>
          {replies.map((r) => (
            <li class="p-comment h-cite">
              {r.authorPhoto ? <img src={r.authorPhoto} alt={r.authorName ?? ''} width="32" height="32" /> : null}
              <div>
                <a href={link(r)} class="author p-author h-card" rel="noopener nofollow" target="_blank">
                  {r.authorName ?? sourceLabel(r)}
                </a>
                {r.content ? <div class="p-content prose">{raw(renderReply(r.content))}</div> : null}
                <a href={r.externalUrl ?? link(r)} class="source u-url" rel="noopener nofollow" target="_blank">
                  {sourceLabel(r)}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
  </section>
) : null}

<style>
  section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--max-width-content);
  }

  h2 {
    font-size: var(--text-lg);
  }

  h2 span {
    font-weight: var(--weight-normal);
    color: var(--color-text-secondary);
  }

  .pile,
  .replies {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .avatars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .avatars a {
    display: block;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    margin-left: -0.375rem;
  }

  .avatars a:first-child {
    margin-left: 0;
  }

  .avatars img,
  .placeholder {
    display: block;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--color-bg);
    transition: transform var(--transition);
    text-decoration: none;
  }

  .avatars img:hover,
  .placeholder:hover {
    transform: translateY(-2px);
    z-index: 1;
    position: relative;
  }

  .placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-2);
    color: var(--color-text-tertiary);
  }

  .overflow {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-left: var(--space-2);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  li > img {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }

  li > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .author {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .author:hover {
    color: var(--color-text-link);
  }

  .p-content {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .source {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .source:hover {
    color: var(--color-text-link);
  }
</style>
