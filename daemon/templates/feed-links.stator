---
import Icon from './icon.stator'

const { title = 'Subscribe' } = Stator.props<{ title?: string }>()
const FEEDS = [
  { href: '/feed.xml', label: 'RSS', aria: 'RSS feed' },
  { href: '/feed.atom', label: 'Atom', aria: 'Atom feed' },
  { href: '/feed.json', label: 'JSON', aria: 'JSON Feed' },
]
---
<div>
  <p>{title}</p>
  <ul>
    {FEEDS.map((feed) => (
      <li>
        <a href={feed.href} aria-label={feed.aria}>
          <Icon name="rss" />
          <span>{feed.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  p {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-2);
  }

  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  li {
    display: flex;
    align-items: center;
  }

  a {
    --icon-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition);
  }

  a:hover {
    border-color: var(--color-brand);
    color: var(--color-text-link);
    text-decoration: none;
  }
</style>
