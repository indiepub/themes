---
import { syndicationMeta } from '../lib/format.ts'
import Icon from './icon.stator'

const { urls, variant = 'compact' } = Stator.props<{ urls?: string[]; variant?: 'compact' | 'detail' }>()
const links = (urls ?? []).map((url) => ({ url, ...syndicationMeta(url) }))
---
{links.length === 0 ? null : variant === 'compact' ? (
  <div class="compact">
    <span class="label">Also on</span>
    {links.map((link) => (
      <a href={link.url} class="u-syndication pill" rel="syndication noopener" target="_blank" aria-label={`${link.label} (opens in new tab)`}>
        <Icon name={link.icon} />
        <span>{link.label}</span>
      </a>
    ))}
  </div>
) : (
  <div class="detail">
    <p class="label">Syndicated to:</p>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.url} class="u-syndication" rel="syndication noopener" target="_blank">
            {link.label}
            <Icon name="external-link" />
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .compact {
    --icon-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .compact .label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.2rem var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text-tertiary);
    background-color: var(--color-surface-2);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    transition: color var(--transition), background-color var(--transition);
  }

  .pill:hover {
    color: var(--color-text-link);
    background-color: var(--color-brand-muted);
    text-decoration: none;
  }

  .detail {
    --icon-size: 0.75rem;
  }

  .detail .label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .detail ul {
    list-style: none;
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .detail a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }
</style>
