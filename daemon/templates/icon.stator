---
import { raw } from '@statorjs/stator/template'
import { ICONS } from '../lib/icons.ts'

const SOCIAL: Record<string, string> = {
  github: 'social/github',
  mastodon: 'social/mastodon',
  bluesky: 'social/bluesky',
  twitter: 'social/x',
  x: 'social/x',
  linkedin: 'social/linkedin',
  instagram: 'social/instagram',
  youtube: 'social/youtube',
  twitch: 'social/twitch',
  threads: 'social/threads',
  gitlab: 'social/gitlab',
  codepen: 'social/codepen',
  dribbble: 'social/dribbble',
  rss: 'rss',
  email: 'mail',
  website: 'globe',
}

/** An inline icon by name (`heart`, `social/github`), or a social link's
 *  icon key with `social`. Sized by the parent's `--icon-size`. */
const { name, social = false } = Stator.props<{ name: string; social?: boolean }>()
const key = social ? (SOCIAL[name] ?? 'link') : name
const svg = (ICONS as Record<string, string>)[key] ?? ICONS.link
---
{raw(svg)}
