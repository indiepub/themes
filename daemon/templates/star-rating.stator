---
const { rating, size = 'base' } = Stator.props<{ rating: number; size?: 'base' | 'xl' }>()
const STARS = [1, 2, 3, 4, 5]
---
<span class={`stars stars--${size}`} aria-label={`Rating: ${rating} out of 5`}>
  {STARS.map((n) => (
    <span class={n <= rating ? 'filled' : undefined} aria-hidden="true">{n <= rating ? '★' : '☆'}</span>
  ))}
</span>

<style>
  .stars {
    display: flex;
    gap: 0.125rem;
  }

  .stars--base {
    font-size: var(--text-base);
  }

  .stars--xl {
    font-size: var(--text-xl);
  }

  span span {
    color: var(--color-border);
  }

  .filled {
    color: var(--color-text-link);
  }
</style>
