---
import SubscribeForm from '@indiepub/stator/components/subscribe-form.stator'
import { SITE_NAME } from '@indiepub/stator/server/site'
import { subscriberCount } from '@indiepub/stator/server/subscribe'
import MemberMachine from '../machines/member.ts'
import { viewerOf } from '../lib/viewer.ts'
import FeedLinks from '../templates/feed-links.stator'
import Layout from '../templates/layout.stator'

const [member] = Stator.reads([MemberMachine])
const viewer = viewerOf(Stator.request, Stator.response)
const subscribers = subscriberCount()
const { query } = Stator.request
---
<Layout title="Subscribe" description={`Subscribe to ${SITE_NAME} for new issues delivered to your inbox.`} path="/subscribe" hideSidebar viewer={viewer}>
  <div class="subscribe">
    <div>
      <h1>Subscribe</h1>
      <p>
        New issues from {SITE_NAME} delivered to your inbox. No spam, unsubscribe any time. Already subscribed? The
        same form sends you a sign-in link for posts that are just for subscribers. Read
        <a href="/newsletter">past issues</a>.
        {subscribers > 0 ? ` Join ${subscribers} ${subscribers === 1 ? 'subscriber' : 'subscribers'}.` : ''}
      </p>
    </div>

    <div class="card">
      <p class="heading">Stay in the loop</p>
      <SubscribeForm query={query} member={member} />
    </div>

    <FeedLinks title="Or follow by feed" />
  </div>
</Layout>

<style>
  .subscribe {
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
  }

  p {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .heading {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }
</style>
