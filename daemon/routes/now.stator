---
import { interactionsFor, listEntries } from '@indiepub/stator/server/entries'
import { formatDate } from '../lib/format.ts'
import { viewerOf } from '../lib/viewer.ts'
import EntryDetail from '../templates/entry-detail.stator'
import Layout from '../templates/layout.stator'

const viewer = viewerOf(Stator.request, Stator.response)
const entry = listEntries({ types: ['note'], tag: 'now', limit: 1, audience: viewer.audience })[0] ?? null
const groups = entry ? interactionsFor(entry.id) : null
---
<Layout title="Now" path="/now" viewer={viewer}>
  <div class="page-header">
    <h1>Now</h1>
    {entry ? (
      <p class="text-sm text-secondary">Last updated {formatDate(entry.publishedAt ?? entry.createdAt)}</p>
    ) : null}
  </div>

  {entry && groups ? (
    <EntryDetail entry={entry} groups={groups} />
  ) : (
    <div class="placeholder">
      <p>
        This is a <a href="https://nownownow.com/about" rel="noopener" target="_blank">/now page</a>: a snapshot of
        what's happening in the site owner's life right now.
      </p>
      <p>
        To update this page, publish a note and tag it with <strong>#now</strong>. The most recent
        <code>now</code>-tagged note will appear here automatically.
      </p>
    </div>
  )}
</Layout>

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    background-color: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    max-width: var(--max-width-content);
  }

  .placeholder p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
