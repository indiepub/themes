---
import { interactionCounts, listEntries } from '@indiepub/stator/server/entries'
import { viewerOf } from '../lib/viewer.ts'
import EntryCard from '../templates/entry-card.stator'
import Layout from '../templates/layout.stator'

const viewer = viewerOf(Stator.request, Stator.response)
const entries = listEntries({ types: ['bookmark'], limit: 30, audience: viewer.audience })
const counts = interactionCounts(entries.map((e) => e.id))
---
<Layout title="Bookmarks" path="/bookmarks" viewer={viewer}>
  <div class="page-header">
    <h1>Bookmarks</h1>
    <p class="text-secondary">Links worth keeping.</p>
  </div>

  {entries.length > 0 ? (
    <div class="h-feed entry-feed" aria-label="Bookmarks feed">
      {entries.map((entry) => <EntryCard entry={entry} counts={counts.get(entry.id)} />)}
    </div>
  ) : (
    <p class="text-secondary">No bookmarks yet.</p>
  )}
</Layout>
