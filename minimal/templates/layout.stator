---
import IndiewebHead from '@indiepub/stator/components/indieweb-head.stator'
import { getAuthor } from '@indiepub/stator/server/entries'
import { SITE_NAME, SITE_ORIGIN } from '@indiepub/stator/server/site'

const { title, description, path, ogImage } = Stator.props<{
  title?: string
  description?: string
  /** The page's own path: the canonical link and the current nav item. */
  path?: string
  ogImage?: string
}>()

const NAV = [
  { href: '/notes', label: 'Notes' },
  { href: '/articles', label: 'Articles' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
]

const author = getAuthor()
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME
const canonical = path ? `${SITE_ORIGIN}${path}` : undefined
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description ? <meta name="description" content={description} /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <meta property="og:title" content={title ?? SITE_NAME} />
    {description ? <meta property="og:description" content={description} /> : null}
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {ogImage ? <meta property="og:image" content={`${SITE_ORIGIN}${ogImage}`} /> : null}
    <link rel="stylesheet" href="/static/global.css" />
    <link rel="stylesheet" href="/highlight.css" />
    <IndiewebHead />
  </head>
  <body>
    <header>
      <a href="/" class="p-name">{SITE_NAME}</a>
      <nav>
        {NAV.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <children />
    </main>

    <footer>
      <span>&copy; {new Date().getFullYear()} {author.name}</span>
      <nav>
        <a href="/subscribe">Subscribe</a>
        <a href="/feed.xml">RSS</a>
      </nav>
    </footer>
  </body>
</html>
