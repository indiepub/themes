---
import { VERB_EMOJI, VERB_LABEL } from '../lib/verbs';

interface Props {
  verb?: string | undefined;
  objectName?: string | undefined;
  objectUrl?: string | undefined;
  rating?: number | undefined;
}

const { verb, objectName, objectUrl, rating } = Astro.props;
---

{verb && objectName && (
  <div class="verb-callout">
    <span class="verb-emoji" aria-hidden="true">{VERB_EMOJI[verb] ?? ''}</span>
    <span>
      {VERB_LABEL[verb] ?? verb}
      {' '}
      {objectUrl ? (
        <a href={objectUrl} class={`u-${verb}-of`} rel="noopener" target="_blank">
          <strong>{objectName}</strong>
        </a>
      ) : (
        <strong class={`p-${verb}-of`}>{objectName}</strong>
      )}
    </span>
  </div>
)}
{rating != null && rating > 0 && (
  <div class="verb-rating" aria-label={`Rating: ${rating} out of 5`}>
    {[1,2,3,4,5].map(n => (
      <span aria-hidden="true">{n <= rating ? '\u2605' : '\u2606'}</span>
    ))}
  </div>
)}

<style>
  .verb-callout {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }

  .verb-emoji {
    font-size: var(--text-lg);
    flex-shrink: 0;
  }

  .verb-callout a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .verb-callout a:hover {
    color: var(--color-accent);
  }

  .verb-rating {
    display: flex;
    gap: 0.125rem;
    font-size: var(--text-base);
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
</style>
