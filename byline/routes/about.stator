---
import { raw } from '@statorjs/stator/template'
import { getAuthor, socialLinks } from '@indiepub/stator/server/entries'
import { renderInlineMarkdown } from '@indiepub/stator/server/render'
import { SITE_ORIGIN } from '@indiepub/stator/server/site'
import Layout from '../templates/layout.stator'

const author = getAuthor()
const links = socialLinks()
---
<Layout title="About" path="/about" width="narrow">
  <article class="h-card">
    {author.photo ? <img src={author.photo} alt={author.name} width="120" height="120" class="u-photo" /> : null}
    <h1><a href={SITE_ORIGIN} class="p-name u-url" rel="me">{author.name || 'About'}</a></h1>
    {author.bio ? <p class="p-note">{raw(renderInlineMarkdown(author.bio))}</p> : null}
    {links.length > 0 ? (
      <ul>
        {links.map((link) => (
          <li><a href={link.url} rel="me noopener" target="_blank">{link.label}</a></li>
        ))}
      </ul>
    ) : null}
    <a href="/subscribe" class="subscribe">Subscribe to my newsletter</a>
  </article>
</Layout>

<style>
  article {
    padding-block: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  img {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.02em;
  }

  h1 a {
    color: inherit;
  }

  h1 a:hover {
    color: inherit;
    text-decoration: none;
  }

  p {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }

  .subscribe {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-full);
    transition: background-color var(--transition);
    align-self: flex-start;
  }

  .subscribe:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-text-on-accent);
    text-decoration: none;
  }
</style>
