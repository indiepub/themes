---
import { reader } from '@indiepub/stator/server/access'
import { listEntries } from '@indiepub/stator/server/entries'
import { ACTIVITY_VERBS } from '@indiepub/stator/server/render'
import { pageOf, paginate } from '../lib/format.ts'
import Layout from '../templates/layout.stator'
import NoteCard from '../templates/note-card.stator'
import Pagination from '../templates/pagination.stator'

const audience = reader(Stator.request, Stator.response)
const page = pageOf(Stator.request.query)
const types = ['note', ...ACTIVITY_VERBS]
const { items, hasPrev, hasNext } = paginate((limit, offset) => listEntries({ types, limit, offset, audience }), page)
---
<Layout title="Notes" path="/notes">
  <div class="notes">
    <h1>Notes</h1>
    {items.length === 0 ? <p class="empty">No notes yet.</p> : null}
    <div class="stream h-feed">
      {items.map((entry) => <NoteCard entry={entry} audience={audience} />)}
    </div>
    <Pagination base="/notes" page={page} hasPrev={hasPrev} hasNext={hasNext} label="Notes pagination" />
  </div>
</Layout>

<style>
  .notes {
    padding-block: var(--space-10);
    max-width: 36rem;
    margin-inline: auto;
  }

  h1 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
  }

  .stream {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .empty {
    color: var(--color-text-secondary);
  }
</style>
