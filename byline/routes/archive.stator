---
import { reader } from '@indiepub/stator/server/access'
import { listEntries } from '@indiepub/stator/server/entries'
import Layout from '../templates/layout.stator'
import PostList from '../templates/post-list.stator'

const audience = reader(Stator.request, Stator.response)
const entries = listEntries({ limit: 10_000, audience })
---
<Layout title="Archive" path="/archive">
  <div class="listing">
    <h1>Archive</h1>
    {entries.length === 0 ? <p class="empty">Nothing here yet.</p> : <PostList entries={entries} />}
  </div>
</Layout>

<style>
  .listing {
    padding-block: var(--space-10);
  }

  h1 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    letter-spacing: -0.02em;
    margin-bottom: var(--space-12);
  }

  .empty {
    color: var(--color-text-secondary);
  }
</style>
