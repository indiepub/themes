---
import SubscribeConfirm from '@indiepub/stator/components/subscribe-confirm.stator'
import Layout from '../../templates/layout.stator'
const { query } = Stator.request
---
<Layout title="Confirm your email" noindex>
  <div class="confirm">
    <h1>Confirm your email</h1>
    <SubscribeConfirm query={query} />
  </div>
</Layout>

<style>
  .confirm {
    max-width: 36rem;
    margin-inline: auto;
    padding-block: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    text-align: center;
  }

  h1 {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
  }
</style>
