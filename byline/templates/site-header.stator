---
import { raw } from '@statorjs/stator/template'
import { SITE_NAME } from '@indiepub/stator/server/site'
import { icon } from '../lib/icons.ts'

const { path = '' } = Stator.props<{ path?: string }>()

const NAV = [
  { href: '/articles', label: 'Articles' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
]
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined)
---
<header>
  <div class="inner">
    <a href="/" class="brand" aria-label="Go to homepage">{SITE_NAME}</a>

    <nav aria-label="Primary navigation">
      {NAV.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
    </nav>

    <a href="/subscribe" class="subscribe">Subscribe</a>

    <details>
      <summary aria-label="Menu">{raw(icon('menu', 20))}</summary>
      <nav aria-label="Mobile navigation">
        {NAV.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
        <a href="/subscribe" class="cta">Subscribe</a>
      </nav>
    </details>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .inner {
    max-width: var(--max-width-site);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-6);
    position: relative;
  }

  .brand {
    flex: 1;
    min-width: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand:hover {
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .inner > nav {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  .inner > nav a {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
  }

  .inner > nav a:hover,
  .inner > nav a[aria-current] {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .subscribe {
    display: none;
    padding: var(--space-2) var(--space-5);
    background-color: var(--color-accent);
    color: var(--color-text-on-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-full);
    transition: background-color var(--transition);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .subscribe:hover {
    background-color: var(--color-accent-hover);
    text-decoration: none;
    color: var(--color-text-on-accent);
  }

  summary {
    display: flex;
    align-items: center;
    padding: var(--space-2);
    cursor: pointer;
    color: var(--color-text-secondary);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-text-primary);
  }

  details nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  details nav a {
    padding: var(--space-3) var(--space-2);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  details nav a:last-child {
    border-bottom: none;
  }

  details nav a:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  details nav a.cta {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  @media (min-width: 480px) {
    .subscribe {
      display: inline-block;
    }
  }

  @media (min-width: 640px) {
    .inner > nav {
      display: flex;
    }

    details {
      display: none;
    }
  }
</style>
