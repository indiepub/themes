---
import { raw } from '@statorjs/stator/template'
import type { Audience, Shown } from '@indiepub/stator/server/access'
import { renderBodyMarkdown } from '@indiepub/stator/server/render'
import { SITE_ORIGIN } from '@indiepub/stator/server/site'
import { icon } from '../lib/icons.ts'
import { longDate, shortDate } from '../lib/format.ts'
import Gate from './gate.stator'
import VerbCallout from './verb-callout.stator'

const { entry, single = false, audience } = Stator.props<{
  entry: Shown
  /** On the note's own page: a long date, not a link. */
  single?: boolean
  audience?: Audience
}>()
const href = `/${entry.slug}`
const iso = entry.publishedAt?.toISOString()
---
<article class="h-entry">
  {iso ? (
    <header>
      {single ? (
        <time class="dt-published" datetime={iso}>{longDate(entry.publishedAt)}</time>
      ) : (
        <a href={href} class="u-url"><time class="dt-published" datetime={iso}>{shortDate(entry.publishedAt)}</time></a>
      )}
    </header>
  ) : null}
  <VerbCallout entry={entry} />
  {entry.gated && entry.summary ? <p class="p-summary">{entry.summary}</p> : null}
  {entry.content ? <div class="e-content prose">{raw(renderBodyMarkdown(entry.content))}</div> : null}
  {entry.gated ? <Gate entry={entry} audience={audience} /> : null}
  <footer>
    <a href={single ? `${SITE_ORIGIN}${href}` : href} class={single ? 'u-url' : undefined} aria-label="Permalink to this note">
      {raw(icon('link', 13))} Share
    </a>
  </footer>
</article>

<style>
  article {
    background-color: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
  }

  header {
    margin-bottom: var(--space-3);
  }

  header a,
  header time {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  header a:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
  }

  footer a:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
</style>
