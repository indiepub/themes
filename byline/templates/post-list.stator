---
import type { Shown } from '@indiepub/stator/server/access'
import { entryTitle } from '@indiepub/stator/server/render'
import { byYear, monthDay } from '../lib/format.ts'

/** Posts as a year-grouped table of contents. */
const { entries } = Stator.props<{ entries: Shown[] }>()
const groups = byYear(entries)
const title = (entry: Shown): string => entryTitle(entry) || (entry.gated ? 'For subscribers' : 'Untitled')
---
<div class="h-feed">
  {groups.map((group) => (
    <section aria-labelledby={`year-${group.year}`}>
      <h2 id={`year-${group.year}`}>{group.year || 'Undated'}</h2>
      <ol>
        {group.entries.map((entry) => (
          <li class="h-entry">
            {entry.publishedAt ? (
              <time class="dt-published" datetime={entry.publishedAt.toISOString()}>{monthDay(entry.publishedAt)}</time>
            ) : (
              <span>—</span>
            )}
            <a href={`/${entry.slug}`} class={entry.name ? 'p-name u-url' : 'u-url'}>{title(entry)}</a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  section {
    margin-bottom: var(--space-10);
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  ol {
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 7ch 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  li:last-child {
    border-bottom: none;
  }

  time,
  span {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  a {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
  }

  a:hover {
    color: var(--color-text-link);
    text-decoration: none;
  }
</style>
