# Copy to .env.local (gitignored). Real shell env wins, then .env.local, then .env.
# Every variable is documented in the @indiepub/stator README.

# The only address a sign-in link goes to. Without RESEND_API_KEY on localhost,
# the link prints to the terminal.
SITE_OWNER_EMAIL=you@example.com
SITE_NAME=My Site
SITE_AUTHOR=Your Name
SITE_ORIGIN=http://localhost:3000
SITE_DB=site.db
SITE_MEDIA=media

# Required in production: 32+ random characters.
# STATOR_SECRET=
# RESEND_API_KEY=
# SITE_MAIL_FROM=My Site <login@example.com>
# 16+ characters; needed to connect Bluesky or Mastodon from the admin.
# SITE_ENCRYPTION_KEY=
# Keeps sessions across restarts.
# REDIS_URL=
# Turns on outbound webmentions and syndication.
# SITE_OUTBOUND=1

# Byline's look: ivory (default), slate, midnight or sepia, and an accent color.
# SITE_PALETTE=ivory
# SITE_ACCENT=oklch(50% 0.14 240)
